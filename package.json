{
  "name": "blog-aggregator",
  "version": "1.0.0",
  "description": "A TypeScript CLI RSS feed aggregator backed by PostgreSQL and Drizzle ORM",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MhmdRayanm7/Blog-Aggregator.git"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "postgresql",
    "drizzle-orm",
    "rss",
    "cli"
  ],
  "author": "Mhmd Rayan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MhmdRayanm7/Blog-Aggregator/issues"
  },
  "homepage": "https://github.com/MhmdRayanm7/Blog-Aggregator#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "postgres": "^3.4.9"
  }
}
